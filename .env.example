# Supabase
# Crea un proyecto en https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role solo en server (no NEXT_PUBLIC). Para tareas admin/cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — fase de pagos
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo — email transaccional (avisos de negocio, ej. "ya eres profesor")
# Settings → SMTP & API → API Keys en app.brevo.com
BREVO_API_KEY=xkeysib-...
# Remitente verificado en Brevo (Settings → Senders & IP)
EMAIL_FROM_ADDRESS=notificaciones@dancebeatacademy.com
EMAIL_FROM_NAME=Dance Beat Academy

# Twilio — WhatsApp (futuro)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
